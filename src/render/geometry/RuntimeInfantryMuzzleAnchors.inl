bool runtimeFindInfantryMuzzleAnchor(const std::string& imageId,
    const std::string& sequenceName, int frameIndex, int globalWidth, int globalHeight,
    POINT& canvasPoint) {
    std::string sequence = toLowerAscii(sequenceName);
    const std::string image = toLowerAscii(imageId);
    // Aliases use identical original start/count/stride, not similar poses.
    if (image == "boris" && sequence == "secondaryprone") sequence = "fireprone";
    if (image == "civa" && sequence == "fireprone") sequence = "fireup";
    if (image == "civb" && sequence == "fireprone") sequence = "fireup";
    if (image == "civc" && sequence == "fireprone") sequence = "fireup";
    if (image == "cleg" && sequence == "fireprone") sequence = "fireup";
    if (image == "cleg" && sequence == "fireprone") sequence = "fireup";
    if (image == "ssrv" && sequence == "fireprone") sequence = "fireup";
    if (image == "ssrv" && sequence == "fireprone") sequence = "fireup";
    if (image == "yurix" && sequence == "wetattack") sequence = "fireup";
    if (image == "yurix" && sequence == "wetattack") sequence = "fireup";
    for (const auto& strip : runtimeInfantryMuzzleAnchorStrips) {
        if (image != strip.image || sequence != toLowerAscii(strip.sequence)
            || globalWidth != strip.width || globalHeight != strip.height) continue;
        const int relative = frameIndex - strip.start;
        if (relative < 0) continue;
        int authoredDirection = 0;
        if (strip.stride == 0) {
            if (relative >= strip.frames) continue;
        } else {
            if (relative >= 8 * strip.stride || relative % strip.stride >= strip.frames) continue;
            authoredDirection = relative / strip.stride;
        }
        const int runtimeDirection = (8 - authoredDirection) % 8;
        canvasPoint = strip.points[static_cast<std::size_t>(runtimeDirection)];
        for (const auto& exception : runtimeInfantryMuzzleFrameAnchors) {
            if (image == exception.image && frameIndex == exception.frame) {
                canvasPoint = exception.point;
                break;
            }
        }
        return true;
    }
    return false;
}
