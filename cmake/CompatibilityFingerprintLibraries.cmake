# H074-01: unchanged production identity codec/file implementation.
include_guard(GLOBAL)
function(concord_register_fingerprint_libraries runtime_owner)
concord_add_profiled_leaf(concord_compatibility_fingerprint_runtime_leaf src/network/maps/RuntimeMultiplayerCompatibilityFingerprint.cpp ${runtime_owner} Runtime)
concord_add_profiled_leaf(concord_compatibility_fingerprint_contract_leaf src/network/maps/RuntimeMultiplayerCompatibilityFingerprint.cpp concord_multiplayer_compatibility_fingerprint_smoke Contract)
target_link_libraries(${runtime_owner} PRIVATE concord_compatibility_fingerprint_runtime_leaf)
set_property(TARGET ${runtime_owner} PROPERTY CONCORD_FINGERPRINT_LIBRARY concord_compatibility_fingerprint_runtime_leaf)
target_link_libraries(concord_multiplayer_compatibility_fingerprint_smoke PRIVATE concord_compatibility_fingerprint_contract_leaf)
set_property(TARGET concord_multiplayer_compatibility_fingerprint_smoke PROPERTY CONCORD_FINGERPRINT_LIBRARY concord_compatibility_fingerprint_contract_leaf)

endfunction()
if(NOT CONCORD_PORTABLE_CORE)
    concord_register_fingerprint_libraries(concord_runtime)
endif()
