# CMake 3.20 contract: frontend variant exists since 3.14, but single-frontend
# MSVC/GNU values were not populated until 3.26. Compiler ID supplies that fallback.
# This file also serves the independently configured Win32 tools project.
include_guard(GLOBAL)

set(CONCORD_CL_EXE OFF)
set(CONCORD_MSVC_FRONTEND OFF)
set(CONCORD_MSVC_ABI OFF)
set(CONCORD_CLANG_CL OFF)
set(CONCORD_COMPILER_FRONTEND "${CMAKE_CXX_COMPILER_FRONTEND_VARIANT}")
if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    set(CONCORD_CL_EXE ON)
    set(CONCORD_MSVC_FRONTEND ON)
    set(CONCORD_COMPILER_FRONTEND "MSVC")
elseif(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    set(CONCORD_MSVC_FRONTEND ON)
elseif(NOT CONCORD_COMPILER_FRONTEND AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    set(CONCORD_COMPILER_FRONTEND "GNU")
endif()
if(WIN32 AND (CONCORD_CL_EXE OR CMAKE_CXX_SIMULATE_ID STREQUAL "MSVC"))
    set(CONCORD_MSVC_ABI ON)
endif()
if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND CONCORD_MSVC_FRONTEND)
    set(CONCORD_CLANG_CL ON)
    if(NOT CONCORD_MSVC_ABI)
        message(FATAL_ERROR "The clang-cl contract requires the Microsoft Windows ABI")
    endif()
endif()

# OS, frontend, ABI, CPU ISA, and window/presentation backends are separate axes.
# A pointer width alone cannot distinguish x64 from ARM64.
set(CONCORD_CPU_ISA "unknown")
set(_concord_arch_identity "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID};${CMAKE_VS_PLATFORM_NAME};${CMAKE_SYSTEM_PROCESSOR}")
if(CONCORD_CPU_ARCH STREQUAL "x64")
    set(CONCORD_CPU_ISA "x86_64")
elseif(CONCORD_CPU_ARCH STREQUAL "x86")
    set(CONCORD_CPU_ISA "x86")
elseif(CONCORD_CPU_ARCH)
    message(FATAL_ERROR "CONCORD_CPU_ARCH must be x64 or x86 for this Windows toolchain")
elseif(CMAKE_CXX_COMPILER_TARGET MATCHES "^x86_64-")
    set(CONCORD_CPU_ISA "x86_64")
elseif(CMAKE_CXX_COMPILER_TARGET MATCHES "^i[3-6]86-")
    set(CONCORD_CPU_ISA "x86")
elseif(_concord_arch_identity MATCHES "(^|;)(ARM64|arm64|aarch64)(;|$)")
    set(CONCORD_CPU_ISA "arm64")
elseif(CMAKE_CXX_COMPILER_ARCHITECTURE_ID MATCHES "^(X86|x86)$" OR CMAKE_VS_PLATFORM_NAME STREQUAL "Win32")
    set(CONCORD_CPU_ISA "x86")
elseif(_concord_arch_identity MATCHES "(^|;)(AMD64|amd64|x64|X64|x86_64)(;|$)")
    set(CONCORD_CPU_ISA "x86_64")
elseif(_concord_arch_identity MATCHES "(^|;)(x86|i[3-6]86)(;|$)")
    set(CONCORD_CPU_ISA "x86")
endif()
if(CONCORD_CPU_ISA STREQUAL "x86_64" AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "x64 CPU contract disagrees with the detected pointer width")
elseif(CONCORD_CPU_ISA STREQUAL "x86" AND NOT CMAKE_SIZEOF_VOID_P EQUAL 4)
    message(FATAL_ERROR "x86 CPU contract disagrees with the detected pointer width")
endif()
if(CONCORD_CPU_ARCH AND CMAKE_CXX_COMPILER_TARGET)
    if(CONCORD_CPU_ARCH STREQUAL "x64" AND NOT CMAKE_CXX_COMPILER_TARGET MATCHES "^x86_64-")
        message(FATAL_ERROR "x64 CPU contract disagrees with CMAKE_CXX_COMPILER_TARGET")
    elseif(CONCORD_CPU_ARCH STREQUAL "x86" AND NOT CMAKE_CXX_COMPILER_TARGET MATCHES "^i[3-6]86-")
        message(FATAL_ERROR "x86 CPU contract disagrees with CMAKE_CXX_COMPILER_TARGET")
    endif()
endif()
message(STATUS "Concord compiler contract: OS=${CMAKE_SYSTEM_NAME}; compiler=${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}; frontend=${CONCORD_COMPILER_FRONTEND}; Microsoft ABI=${CONCORD_MSVC_ABI}; CPU ISA=${CONCORD_CPU_ISA}")
if(WIN32)
    message(STATUS "Concord current product backends: window=Win32; presentation=GDI/software (separate from compiler/ISA)")
endif()
if(CONCORD_CLANG_CL)
    message(STATUS "clang-cl mapping: keep target /W4 /WX, /EHsc, /utf-8, optimization and CRT differences; omit /FS, /RTC1, /bigobj, /permissive-; map only the existing target-specific /wd4189, /wd4996 and /wd4702")
    message(STATUS "clang-cl Debug /RTC1 is unsupported; no substitute runtime-check coverage is claimed. /bigobj is automatic COFF behavior; /FS is a cl.exe PDB writer option; /permissive- has no Clang counterpart.")
    message(STATUS "Clang warning groups preserve the existing per-target suppression intent; numeric MSVC warnings and Clang groups are not one-to-one coverage.")
    message(STATUS "clang-cl FP contract: -fno-fast-math -ffp-contract=off; /O2 remains the driver spelling (LLVM optimization level is inspected from real commands, not assumed equivalent to cl.exe)")
endif()

# Preserve the original cl.exe arguments byte-for-byte. Translate only the
# selected clang-cl driver's unsupported/irrelevant options, on the same targets.
function(concord_target_compile_options target)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "Cannot apply compiler options to missing target ${target}")
    endif()
    set(_concord_options)
    foreach(_concord_option IN LISTS ARGN)
        set(_concord_mapped "${_concord_option}")
        if(CONCORD_CLANG_CL)
            if(_concord_option STREQUAL "/FS" OR _concord_option STREQUAL "/bigobj" OR _concord_option STREQUAL "/permissive-" OR _concord_option STREQUAL "/RTC1" OR _concord_option STREQUAL "$<$<CONFIG:Debug>:/RTC1>")
                set(_concord_mapped "")
            elseif(_concord_option STREQUAL "/wd4189")
                set(_concord_mapped "-Wno-unused-variable")
            elseif(_concord_option STREQUAL "/wd4996")
                set(_concord_mapped "-Wno-deprecated-declarations")
            elseif(_concord_option STREQUAL "/wd4702")
                set(_concord_mapped "-Wno-unreachable-code")
            elseif(_concord_option MATCHES "^/wd[0-9]+$")
                message(FATAL_ERROR "No reviewed clang-cl warning mapping for ${target}: ${_concord_option}")
            endif()
            if(NOT _concord_mapped STREQUAL _concord_option)
                if(_concord_mapped)
                    set(_concord_action "${_concord_mapped}")
                else()
                    set(_concord_action "omitted; see frontend contract")
                endif()
                message(STATUS "clang-cl ${target}: ${_concord_option} -> ${_concord_action}")
                set_property(TARGET "${target}" APPEND PROPERTY CONCORD_OPTION_TRANSLATIONS "${_concord_option} -> ${_concord_action}")
            endif()
        endif()
        if(_concord_mapped)
            list(APPEND _concord_options "${_concord_mapped}")
        endif()
    endforeach()
    list(LENGTH _concord_options _concord_option_count)
    if(_concord_option_count GREATER 1)
        target_compile_options("${target}" ${_concord_options})
    endif()
endfunction()

# Call after this directory's executable/library targets have been created.
# Actual compile/link argv still comes from compile_commands.json and verbose
# build output; this resolved target-property report makes differences reviewable.
function(concord_finalize_compiler_contract)
    set(_concord_report "OS=${CMAKE_SYSTEM_NAME}\ncompiler=${CMAKE_CXX_COMPILER}\ncompiler_id=${CMAKE_CXX_COMPILER_ID}\ncompiler_version=${CMAKE_CXX_COMPILER_VERSION}\nfrontend=${CONCORD_COMPILER_FRONTEND}\nMicrosoft_ABI=${CONCORD_MSVC_ABI}\nCPU_ISA=${CONCORD_CPU_ISA}\nconfiguration=$<CONFIG>\nCXX_FLAGS=${CMAKE_CXX_FLAGS}\nCXX_FLAGS_DEBUG=${CMAKE_CXX_FLAGS_DEBUG}\nCXX_FLAGS_RELEASE=${CMAKE_CXX_FLAGS_RELEASE}\nCXX_FLAGS_RELWITHDEBINFO=${CMAKE_CXX_FLAGS_RELWITHDEBINFO}\nCXX_FLAGS_MINSIZEREL=${CMAKE_CXX_FLAGS_MINSIZEREL}\n")
    get_property(_concord_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    foreach(_concord_target IN LISTS _concord_targets)
        get_target_property(_concord_type "${_concord_target}" TYPE)
        if(_concord_type STREQUAL "UTILITY" OR _concord_type STREQUAL "INTERFACE_LIBRARY")
            continue()
        endif()
        if(CONCORD_CLANG_CL)
            get_target_property(_concord_existing_options "${_concord_target}" COMPILE_OPTIONS)
            set(_concord_flag_inputs "${CMAKE_CXX_FLAGS};${CMAKE_CXX_FLAGS_DEBUG};${CMAKE_CXX_FLAGS_RELEASE};${CMAKE_CXX_FLAGS_RELWITHDEBINFO};${CMAKE_CXX_FLAGS_MINSIZEREL};${_concord_existing_options}")
            string(REPLACE "/clang:" "" _concord_flag_inputs "${_concord_flag_inputs}")
            if(_concord_flag_inputs MATCHES "(^|[ ;:])(-ffast-math|-Ofast|/fp:fast|/fp:contract|-ffp-model=fast|-funsafe-math-optimizations|-fassociative-math|-ffinite-math-only|-freciprocal-math|-fapprox-func|-fno-honor-nans|-fno-honor-infinities|-fno-signed-zeros|-march=native|/arch:AVX2)([ ;>]|$)")
                message(FATAL_ERROR "Unverified FP/global ISA option conflicts with clang-cl contract for ${_concord_target}: ${_concord_flag_inputs}")
            endif()
            string(REGEX MATCHALL "(^|[ ;:])-ffp-contract=[^ ;>]+" _concord_contraction_inputs "${_concord_flag_inputs}")
            foreach(_concord_contraction_input IN LISTS _concord_contraction_inputs)
                if(NOT _concord_contraction_input MATCHES "-ffp-contract=off$")
                    message(FATAL_ERROR "clang-cl requires -ffp-contract=off for ${_concord_target}; rejected ${_concord_contraction_input}")
                endif()
            endforeach()
            # The selected toolchain already sets these flags for compiler probes
            # and every target. Also protect direct Clang configurations without
            # duplicating flags supplied by that toolchain.
            foreach(_concord_policy_flag "/clang:-fno-fast-math" "/clang:-ffp-contract=off" "-Werror=unknown-argument" "-Werror=unused-command-line-argument")
                string(REPLACE "/clang:" "" _concord_policy_token "${_concord_policy_flag}")
                string(FIND "${CMAKE_CXX_FLAGS}" "${_concord_policy_token}" _concord_policy_index)
                if(_concord_policy_index EQUAL -1)
                    target_compile_options("${_concord_target}" PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:${_concord_policy_flag}>")
                endif()
            endforeach()
        endif()
        get_target_property(_concord_crt "${_concord_target}" MSVC_RUNTIME_LIBRARY)
        if(NOT _concord_crt)
            if(CONCORD_MSVC_ABI)
                set(_concord_crt "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL (CMake default)")
            else()
                set(_concord_crt "not Microsoft ABI")
            endif()
        endif()
        string(APPEND _concord_report "\ntarget=${_concord_target}\ntype=${_concord_type}\nCRT=${_concord_crt}\noutput=$<TARGET_FILE:${_concord_target}>\noptions=$<JOIN:$<TARGET_GENEX_EVAL:${_concord_target},$<TARGET_PROPERTY:${_concord_target},COMPILE_OPTIONS>>, >\ndefinitions=$<JOIN:$<TARGET_GENEX_EVAL:${_concord_target},$<TARGET_PROPERTY:${_concord_target},COMPILE_DEFINITIONS>>, >\n")
    endforeach()
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/compiler-contract-$<CONFIG>.txt" CONTENT "${_concord_report}")
endfunction()
