# W01802 scoped radar CPU writer and private native adapter.
include_guard(GLOBAL)
add_executable(concord_radar_pixel_store_value_contract tests/infrastructure/radar_pixel_store/RadarPixelStoreValueContract.cpp)
target_include_directories(concord_radar_pixel_store_value_contract PRIVATE src)
target_compile_features(concord_radar_pixel_store_value_contract PRIVATE cxx_std_20)
target_compile_options(concord_radar_pixel_store_value_contract PRIVATE "$<TARGET_GENEX_EVAL:concord_runtime_match_score_contract,$<TARGET_PROPERTY:concord_runtime_match_score_contract,COMPILE_OPTIONS>>")
target_compile_definitions(concord_radar_pixel_store_value_contract PRIVATE "$<TARGET_GENEX_EVAL:concord_runtime_match_score_contract,$<TARGET_PROPERTY:concord_runtime_match_score_contract,COMPILE_DEFINITIONS>>")
if(CONCORD_MSVC_ABI)
 set_property(TARGET concord_radar_pixel_store_value_contract PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
endif()
if(WIN32)
 concord_add_profiled_leaf(concord_radar_pixel_store_win32 src/ui/radar/win32/RuntimeRadarPixelStoreWin32.cpp concord_runtime Runtime)
 concord_add_profiled_leaf(concord_radar_pixel_store_win32_contract_leaf src/ui/radar/win32/RuntimeRadarPixelStoreWin32.cpp concord_runtime_match_score_contract Contract)
 target_link_libraries(concord_runtime PRIVATE concord_radar_pixel_store_win32)
 add_executable(concord_radar_pixel_store_native_contract tests/infrastructure/radar_pixel_store/RadarPixelStoreNativeContract.cpp)
 target_include_directories(concord_radar_pixel_store_native_contract PRIVATE src)
 target_compile_features(concord_radar_pixel_store_native_contract PRIVATE cxx_std_20)
 target_compile_options(concord_radar_pixel_store_native_contract PRIVATE "$<TARGET_GENEX_EVAL:concord_runtime_match_score_contract,$<TARGET_PROPERTY:concord_runtime_match_score_contract,COMPILE_OPTIONS>>")
 target_compile_definitions(concord_radar_pixel_store_native_contract PRIVATE NOMINMAX "$<TARGET_GENEX_EVAL:concord_runtime_match_score_contract,$<TARGET_PROPERTY:concord_runtime_match_score_contract,COMPILE_DEFINITIONS>>")
 target_link_libraries(concord_radar_pixel_store_native_contract PRIVATE concord_radar_pixel_store_win32_contract_leaf user32 gdi32)
 if(CONCORD_MSVC_ABI)
  set_property(TARGET concord_radar_pixel_store_native_contract PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
 endif()
endif()

if(CONCORD_MSVC_ABI)
 target_compile_definitions(concord_radar_pixel_store_value_contract PRIVATE _CRT_SECURE_NO_WARNINGS)
endif()
add_test(NAME radar_pixel_store_value_contract_test COMMAND concord_radar_pixel_store_value_contract)
set_tests_properties(radar_pixel_store_value_contract_test PROPERTIES TIMEOUT 30 LABELS "standard;radar;values")
if(TARGET concord_radar_pixel_store_native_contract)
 add_test(NAME radar_pixel_store_native_contract_test COMMAND concord_radar_pixel_store_native_contract)
 set_tests_properties(radar_pixel_store_native_contract_test PROPERTIES TIMEOUT 60 RUN_SERIAL TRUE LABELS "windows;radar;native-reference")
endif()

# Keep the original standard getenv selector with the Windows CRT profile.
# These are new standalone native targets only; /WX remains enabled.
if(CONCORD_MSVC_ABI AND TARGET concord_radar_pixel_store_native_contract)
 foreach(t IN ITEMS concord_radar_pixel_store_win32 concord_radar_pixel_store_win32_contract_leaf concord_radar_pixel_store_native_contract)
  target_compile_definitions(${t} PRIVATE _CRT_SECURE_NO_WARNINGS)
 endforeach()
