# Explicit external output, no cleanup/default writes into player data.
foreach(required REFERENCE_EXECUTABLE LAYOUT_FIXTURE FONT_FILE)
 if(NOT DEFINED ${required} OR NOT EXISTS "${${required}}")
  message(FATAL_ERROR "Missing actual Main font-reference input: ${required}")
 endif()
endforeach()
if(NOT DEFINED ENV{CONCORD_MAIN_BITMAP_REFERENCE_OUTPUT} OR "$ENV{CONCORD_MAIN_BITMAP_REFERENCE_OUTPUT}" STREQUAL "")
 message(FATAL_ERROR "Set CONCORD_MAIN_BITMAP_REFERENCE_OUTPUT to an explicit external evidence directory")
endif()
set(parent "$ENV{CONCORD_MAIN_BITMAP_REFERENCE_OUTPUT}")
if(NOT IS_ABSOLUTE "${parent}")
 message(FATAL_ERROR "Font reference output must be absolute")
endif()
string(TIMESTAMP stamp "%Y%m%d-%H%M%S" UTC)
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef nonce)
set(output "${parent}/${stamp}-${nonce}")
execute_process(COMMAND "${REFERENCE_EXECUTABLE}" "${LAYOUT_FIXTURE}" "${FONT_FILE}" "${output}" RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
message("Main font reference output: ${output}\n${stdout}${stderr}")
if(NOT code STREQUAL "0")
 message(FATAL_ERROR "Main font original reference actual exit: ${code}")
endif()
