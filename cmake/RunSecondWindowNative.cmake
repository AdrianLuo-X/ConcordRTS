cmake_minimum_required(VERSION 3.20)
foreach(required GAME_EXECUTABLE SOURCE_ROOT OUTPUT_PARENT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
get_filename_component(root "${SOURCE_ROOT}" ABSOLUTE)
get_filename_component(parent "${OUTPUT_PARENT}" ABSOLUTE)
file(TO_CMAKE_PATH "${root}" root)
file(TO_CMAKE_PATH "${parent}" parent)
string(FIND "${parent}/" "${root}/" local_prefix)
if(NOT local_prefix EQUAL 0)
    message(FATAL_ERROR "P11 test output must stay inside this project")
endif()
string(TIMESTAMP stamp "%Y%m%d-%H%M%S" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef unique)
set(run "${parent}/${stamp}-${unique}")
if(EXISTS "${run}")
    message(FATAL_ERROR "P11 run directory must be new")
endif()
file(MAKE_DIRECTORY "${run}/cwd" "${run}/temp")
file(SHA256 "${GAME_EXECUTABLE}" executable_sha)
file(WRITE "${run}/argv.txt" "${GAME_EXECUTABLE}\n--config\n${run}/private.ini\n--skirmish-ui-smoke-test\n${run}/menu.bmp\n--resource-root\n${root}/RedAlert2\n--local-data-root\n${root}/local_data\n--map\n${root}/local_data/resources/mix_exports/multimd/2peaks.map\n")
string(TIMESTAMP started "%Y-%m-%dT%H:%M:%SZ" UTC)
execute_process(COMMAND "${CMAKE_COMMAND}" -E env
    "TEMP=${run}/temp" "TMP=${run}/temp"
    "CONCORD_SECOND_WINDOW_CONTRACT_OUTPUT=${run}/samples"
    "${GAME_EXECUTABLE}" --config "${run}/private.ini"
    --skirmish-ui-smoke-test "${run}/menu.bmp"
    --resource-root "${root}/RedAlert2" --local-data-root "${root}/local_data"
    --map "${root}/local_data/resources/mix_exports/multimd/2peaks.map"
    WORKING_DIRECTORY "${run}/cwd"
    RESULT_VARIABLE native_result OUTPUT_FILE "${run}/stdout.log" ERROR_FILE "${run}/stderr.log" TIMEOUT 150)
string(TIMESTAMP finished "%Y-%m-%dT%H:%M:%SZ" UTC)
file(SHA256 "${run}/stdout.log" stdout_sha)
file(SHA256 "${run}/stderr.log" stderr_sha)
file(SHA256 "${run}/argv.txt" argv_sha)
if("${native_result}" MATCHES "^-?[0-9]+$")
    set(actual "${native_result}")
else()
    set(actual null)
endif()
string(REPLACE "\\" "\\\\" escaped_result "${native_result}")
string(REPLACE "\"" "\\\"" escaped_result "${escaped_result}")
string(REPLACE "\n" "\\n" escaped_result "${escaped_result}")
file(WRITE "${run}/native-result.json" "{\n\"schema\":\"P11RegisteredNativeResult/v1\",\n\"executable\":\"${GAME_EXECUTABLE}\",\n\"executableSha256\":\"${executable_sha}\",\n\"startedUtc\":\"${started}\",\n\"finishedUtc\":\"${finished}\",\n\"cwd\":\"${run}/cwd\",\n\"output\":\"${run}/samples\",\n\"actualExit\":${actual},\n\"nativeResultRaw\":\"${escaped_result}\",\n\"argvSha256\":\"${argv_sha}\",\n\"stdoutSha256\":\"${stdout_sha}\",\n\"stderrSha256\":\"${stderr_sha}\"\n}\n")
file(READ "${run}/stdout.log" native_stdout)
file(READ "${run}/stderr.log" native_stderr)
message(STATUS "P11 native result: ${run}/native-result.json")
message("${native_stdout}")
if(NOT "${native_stderr}" STREQUAL "")
    message("${native_stderr}")
endif()
if(NOT "${native_result}" STREQUAL "0")
    message(FATAL_ERROR "P11 actual native matrix failed: ${native_result}; original outputs retained")
endif()
