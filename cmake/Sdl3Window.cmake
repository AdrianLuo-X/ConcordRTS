include_guard(GLOBAL)
option(CONCORD_ENABLE_SDL3_WINDOW "Build the optional P11 SDL3 software window (no automatic download)" OFF)
set(CONCORD_SDL3_SOURCE_ROOT "${CMAKE_SOURCE_DIR}/build/dependencies/sdl3-3.4.16/SDL3-3.4.16" CACHE PATH "Verified SDL3 3.4.16 source")
concord_add_profiled_leaf(concord_sdl3_window src/runtime/window/sdl3/RuntimeSdl3Window.cpp concord_runtime Runtime)
target_link_libraries(concord_runtime PRIVATE concord_sdl3_window)
if(CONCORD_ENABLE_SDL3_WINDOW)
    if(NOT WIN32)
        message(FATAL_ERROR "P11 SDL3 loader is currently verified on Windows only")
    endif()
    if(NOT EXISTS "${CONCORD_SDL3_SOURCE_ROOT}/include/SDL3/SDL_version.h")
        message(FATAL_ERROR "Supply the pinned SDL3 3.4.16 source; no automatic dependency installation is performed")
    endif()
    target_include_directories(concord_sdl3_window PRIVATE "${CONCORD_SDL3_SOURCE_ROOT}/include")
    target_compile_definitions(concord_sdl3_window PRIVATE CONCORD_HAS_SDL3=1)
endif()
if(CONCORD_MSVC_FRONTEND)
    concord_target_compile_options(concord_sdl3_window PRIVATE /W4 /WX)
endif()
