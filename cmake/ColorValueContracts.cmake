# W003 selected skirmish bitmap RGB value; no native dependency in product header.
include_guard(GLOBAL)
foreach(pair IN ITEMS "concord_color_values_contract|tests/infrastructure/RuntimeColorValuesContract.cpp" "concord_color_values_win32_contract|tests/infrastructure/RuntimeColorValuesWin32Contract.cpp")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 name)
    list(GET fields 1 source)
    add_executable(${name} ${source})
    target_include_directories(${name} PRIVATE src)
    target_compile_features(${name} PRIVATE cxx_std_20)
    target_compile_options(${name} PRIVATE "$<TARGET_GENEX_EVAL:concord_runtime_match_score_contract,$<TARGET_PROPERTY:concord_runtime_match_score_contract,COMPILE_OPTIONS>>")
    target_compile_definitions(${name} PRIVATE "$<TARGET_GENEX_EVAL:concord_runtime_match_score_contract,$<TARGET_PROPERTY:concord_runtime_match_score_contract,COMPILE_DEFINITIONS>>")
    if(CONCORD_MSVC_ABI)
        set_property(TARGET ${name} PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
    endif()
endforeach()
