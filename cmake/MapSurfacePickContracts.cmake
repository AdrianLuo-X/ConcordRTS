# P02/W00217 one surface-pick value contract.
include_guard(GLOBAL)
add_subdirectory(tests/infrastructure/map_surface_pick)

if(WIN32 AND NOT CONCORD_PORTABLE_CORE)
    add_test(NAME map_surface_pick_harvester_complete_test COMMAND concord_runtime --command-smoke-test --resource-root "${CMAKE_SOURCE_DIR}/RedAlert2" --local-data-root "${CMAKE_SOURCE_DIR}/local_data" --map "${CMAKE_SOURCE_DIR}/local_data/resources/mix_exports/multimd/dryheat.map")
    set_tests_properties(map_surface_pick_harvester_complete_test PROPERTIES RUN_SERIAL TRUE TIMEOUT 1800 ENVIRONMENT "CONCORD_COMMAND_SMOKE_HARVESTER_CURSOR_ONLY=1" LABELS "assets;map-surface-pick;original-complete")
    foreach(driver hardware warp)
        foreach(kind vxl light)
            add_test(NAME map_surface_pick_gpu_${kind}_${driver}_complete_test COMMAND concord_runtime --interaction-smoke-test --resource-root "${CMAKE_SOURCE_DIR}/RedAlert2" --local-data-root "${CMAKE_SOURCE_DIR}/local_data" --map "${CMAKE_SOURCE_DIR}/local_data/resources/mix_exports/mapsmd03/all01umd.map")
            if(kind STREQUAL "vxl")
                set(variant "CONCORD_S41_VXL_GPU_CONTRACT=1")
            else()
                set(variant "CONCORD_S41_LIGHT_WORLD_CONTRACT=1")
            endif()
            set_tests_properties(map_surface_pick_gpu_${kind}_${driver}_complete_test PROPERTIES RUN_SERIAL TRUE TIMEOUT 1800 ENVIRONMENT "CONCORD_S41_TERRAIN_GPU_CONTRACT=${driver};${variant}" LABELS "assets;map-surface-pick;gpu;original-complete")
        endforeach()
    endforeach()
endif()
